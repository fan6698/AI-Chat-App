# ===========================================================
# 两种运行模式，按需二选一
# -----------------------------------------------------------
# 模式 A：本地开发（直连）
#   配置 VITE_ZHIPU_API_KEY，浏览器直连智谱。
#   注意：VITE_ 前缀的变量会被打包进前端产物，仅本地使用，切勿用于公网部署。
#
# 模式 B：部署上线（服务端代理，推荐）
#   不设置 VITE_ZHIPU_API_KEY（留空即可），前端自动改为请求同源的 /api/chat，
#   Key 由服务端环境变量 ZHIPU_API_KEY 持有，不会出现在前端。
# ===========================================================

# 模式 A 才需要填；模式 B 请保持为空
VITE_ZHIPU_API_KEY=

# 可选：直连模式下的模型编码
VITE_ZHIPU_MODEL=glm-4-flash

# 可选：自建网关或代理时填写，默认官方地址 https://open.bigmodel.cn/api/paas/v4
VITE_ZHIPU_BASE_URL=

# 可选：服务端代理地址，默认 /api/chat。前后端分离部署时才需要改成完整 URL
VITE_CHAT_ENDPOINT=
